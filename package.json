{
  "name": "ashd",
  "version": "2.0.0",
  "private": true,
  "description": "ASHD - AS/환불/보증 관리 서비스 (Next.js + Supabase)",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:types": "supabase gen types typescript --schema=public > src/types/database.ts",
    "eval": "tsx eval/run-eval.ts",
    "test": "tsx --test src/lib/kst.test.ts src/lib/escape-html.test.ts src/lib/job-policies.test.ts src/lib/extractors/validate.test.ts src/lib/extractors/rule.test.ts src/lib/notifications/select-alerts.test.ts src/lib/auth/safe-next.test.ts",
    "eval:korie": "tsx eval/adapters/korie.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@base-ui/react": "^1.4.1",
    "@polar-sh/sdk": "^0.48.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^15.3.3",
    "pino": "^10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.12.3",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20"
  }
}
